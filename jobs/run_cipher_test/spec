---
name: run_cipher_test

templates:
  run.erb: bin/run

packages:

properties:
  router.ip:
    description: IP of the gorouter to test
  router.port:
    description: port to connect to the gorouter on
    default: 443
  router.ciphers:
    description: list of OpenSSL cipher names for TLS 1.2 and lower (colon-separated); TLS 1.3 suites are not tested, and the router must accept TLS 1.2; each entry must be a single exact OpenSSL cipher name, not an alias or cipher string (e.g. HIGH, ECDHE+AESGCM), not an RFC name such as TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
